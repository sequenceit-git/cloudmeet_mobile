{
  "expo": {
    "name": "云讯",
    "slug": "cloudnewsmeet",
    "scheme": "cloudnews",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#050B14"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cloudnews.mobile",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.cloudnews.mobile"
        ]
      },
      "infoPlist": {
        "RTCAppGroupIdentifier": "group.com.cloudnews.mobile",
        "RTCScreenSharingExtension": "com.cloudnews.mobile.broadcast",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSCameraUsageDescription": "Cloud News requires camera access for real-time video meetings.",
        "NSMicrophoneUsageDescription": "Cloud News requires microphone access for meeting audio communication.",
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "launchMode": "singleTask",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logo.png",
        "backgroundColor": "#050B14"
      },
      "package": "com.cloudnews.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./src/assets/images/logo.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/PlusJakartaSans-Regular.ttf",
            "./src/assets/fonts/PlusJakartaSans-Medium.ttf",
            "./src/assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./src/assets/fonts/PlusJakartaSans-Bold.ttf",
            "./src/assets/fonts/PlusJakartaSans-ExtraBold.ttf",
            "./src/assets/fonts/PlusJakartaSans-Light.ttf",
            "./src/assets/fonts/PlusJakartaSans-Italic.ttf",
            "./src/assets/fonts/PlusJakartaSans-BoldItalic.ttf",
            "./src/assets/fonts/PlusJakartaSans-MediumItalic.ttf",
            "./src/assets/fonts/PlusJakartaSans-SemiBoldItalic.ttf"
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "c72a3dc6-2192-48f2-b648-3251da00082a"
      }
    },
    "owner": "sequenceitbd"
  }
}
