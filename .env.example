# Cloud News Mobile Environment Configuration
# Use your Mac's LAN IP (e.g. 192.168.0.103) for physical device testing,
# or 10.0.2.2 for Android Studio Emulator.

# API Base URL (Port 8001)
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.103:8001/api/v1

# LiveKit WebSocket Server URL (Port 7880)
EXPO_PUBLIC_LIVEKIT_WS_URL=ws://192.168.0.103:7880

# Web Links
EXPO_PUBLIC_INVITE_WEB_URL=https://cloudnewsmeet.com
EXPO_PUBLIC_DEEP_LINK_SCHEME=cloudnews://
